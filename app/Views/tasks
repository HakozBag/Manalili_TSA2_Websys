<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Task</title>
    <link rel="stylesheet" href="<?= base_url('assets/style.css') ?>">
</head>
<body>
    <div class="form-container">
        <h1>Edit Task</h1>
        
        <form action="<?= base_url('tasks/update/' . $task['id']) ?>" method="post">
            <?= csrf_field() ?>
            <div class="form-group">
                <label>Title</label>
                <input type="text" name="title" value="<?= esc($task['title']) ?>" required>
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" required><?= esc($task['description']) ?></textarea>
            </div>
            <button type="submit">Update Task</button>
        </form>
        
        <a href="<?= base_url('/tasks') ?>">Back to Tasks</a>
    </div>
</body>
</html>